# Copy this file to .env.local and put the real values THERE.
# Never put real keys in this file — it is committed to git.
#
# Anything starting with NEXT_PUBLIC_ is compiled into the JavaScript the
# browser downloads. Treat those as public. Everything else stays on the
# server and never reaches the visitor.

# ---------- site ----------
# Used to build the password-reset link that is emailed to you.
# Locally: http://localhost:3000
PUBLIC_SITE_URL=https://uniqueweblayer.com

# ---------- mysql ----------
# On cPanel the host is usually `localhost` and the names carry an account
# prefix (e.g. mygallab_uwl). Use exactly what cPanel shows you.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=uniqueweblayer
DB_CONNECTION_LIMIT=10

# ---------- admin login ----------
ADMIN_EMAIL=info@uniqueweblayer.com
# Only used for the FIRST sign-in. After that the password lives in the
# admin_account table as a hash, and is changed from /admin/settings.
ADMIN_PASSWORD=change-this-to-a-long-password
# Signs the admin session. Changing it signs every browser out.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------- smtp / nodemailer (cPanel mailbox) ----------
SMTP_HOST=uniqueweblayer.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@uniqueweblayer.com
SMTP_PASSWORD=your-mailbox-password
# Shown as the "From" on outgoing mail — must match SMTP_USER on most cPanel hosts
MAIL_FROM_NAME=Unique Web Layer
MAIL_FROM_ADDRESS=contact@uniqueweblayer.com
# Where contact-form leads are delivered
CONTACT_TO_EMAIL=info@uniqueweblayer.com
# Send the enquirer an automatic acknowledgement
SEND_AUTOREPLY=true

# ---------- google analytics (optional) ----------
# Leave blank and no analytics script loads at all — which is what you want
# locally, so your own visits never appear in the numbers.
# GA4 → Admin → Data streams → your stream → Measurement ID (starts with G-).
NEXT_PUBLIC_GA_ID=

# ---------- not needed ----------
# PORT and HOST are set by the host (cPanel / Passenger) — do not set them here.
# The AI chatbot and the Turnstile captcha were removed, so GROQ_API_KEY,
# OPENAI_API_KEY, NEXT_PUBLIC_TURNSTILE_SITE_KEY and TURNSTILE_SECRET_KEY
# are gone too. The contact form is protected by a honeypot field and a
# rate limit instead.
# There is no separate API server any more, so NEXT_PUBLIC_API_URL and
# CORS_ORIGIN no longer exist either.
